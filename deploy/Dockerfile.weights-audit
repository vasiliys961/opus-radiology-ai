# Tiny, independent deployment audit image. No Torch, no models, no downloads.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/opus
COPY scripts/audit-totalsegmentator.py scripts/audit-totalsegmentator.py
COPY services/imaging-ai/totalsegmentator_audit.py services/imaging-ai/totalsegmentator_audit.py
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin opus
USER 10001:10001
ENTRYPOINT ["python","scripts/audit-totalsegmentator.py"]
